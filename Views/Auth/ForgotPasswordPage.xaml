<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScaffTrack1.Views.Auth.ForgotPasswordPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F1F3F5">
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="18,14" ColumnDefinitions="30,*,40" BackgroundColor="White">
            <Button Text="‹" Clicked="OnBackClicked" BackgroundColor="Transparent" TextColor="#1B2734" FontSize="24" Padding="0" />
            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="Récupérer l’accès" FontSize="17" FontAttributes="Bold" TextColor="#1B2734" />
                <Label Text="Un lien sécurisé par e-mail" FontSize="10" TextColor="#586B84" />
            </VerticalStackLayout>
            <Border Grid.Column="2" WidthRequest="32" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="#F1F3F5">
                <Image Source="icon_lock.svg" WidthRequest="17" HeightRequest="17" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="18,16" Spacing="12">
                <Border WidthRequest="58" HeightRequest="58" StrokeThickness="0" StrokeShape="RoundRectangle 16" BackgroundColor="#E8F1F7">
                    <Image Source="icon_lock.svg" WidthRequest="25" HeightRequest="25" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="Mot de passe oublié ?" FontSize="20" FontAttributes="Bold" TextColor="#1B2734" />
                <Label Text="Indiquez l’adresse liée à votre compte. Nous vous enverrons un lien pour créer un nouveau mot de passe." FontSize="12" TextColor="#586B84" LineBreakMode="WordWrap" />
                <VerticalStackLayout Spacing="5" Margin="0,4,0,0">
                    <Label Text="Adresse e-mail professionnelle *" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" />
                    <Border Padding="10,0" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 9">
                        <Entry x:Name="EmailEntry" Keyboard="Email" Placeholder="nom@entreprise.com" TextColor="#1B2734" />
                    </Border>
                </VerticalStackLayout>
                <Border x:Name="RequestStatus" IsVisible="False" Padding="10" StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="#E7F7EF">
                    <Grid ColumnDefinitions="22,*" ColumnSpacing="6">
                        <Label Text="✓" FontSize="14" FontAttributes="Bold" TextColor="#087A50" />
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Demande reçue" FontSize="11" FontAttributes="Bold" TextColor="#087A50" />
                            <Label Text="Si le compte existe, un e-mail de réinitialisation sera envoyé lorsque le service sera configuré." FontSize="10" TextColor="#087A50" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <Button x:Name="SendButton" Text="➤  Envoyer le lien" Clicked="OnSendClicked" BackgroundColor="#DE4A0A" TextColor="White" FontAttributes="Bold" CornerRadius="9" HeightRequest="44" />
                <Border Padding="12" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Consultez votre messagerie" FontSize="13" FontAttributes="Bold" TextColor="#1B2734" />
                        <Label Text="Le lien sera valide 30 minutes. Pensez à vérifier les courriers indésirables." FontSize="11" TextColor="#586B84" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Nouvel envoi possible dans" FontSize="10" TextColor="#586B84" />
                            <Label x:Name="CountdownLabel" Grid.Column="1" Text="—" FontSize="10" FontAttributes="Bold" TextColor="#1B2734" />
                        </Grid>
                        <Button x:Name="ResendButton" Text="Renvoyer le lien" Clicked="OnSendClicked" IsEnabled="False" BackgroundColor="#E4E8ED" TextColor="#65758B" FontAttributes="Bold" CornerRadius="8" HeightRequest="38" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
