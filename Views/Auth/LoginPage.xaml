<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ScaffTrack1.ViewModels.Auth"
             x:Class="ScaffTrack1.Views.Auth.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F1F3F5">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="20,12,20,14">
            <VerticalStackLayout Spacing="2">
                <Label Text="Bienvenue"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#1B2734" />
                <Label Text="Votre parc, toujours sous contrôle"
                       FontSize="12"
                       TextColor="#586B84" />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,14,16,20" Spacing="10">
                <Grid ColumnDefinitions="36,*" ColumnSpacing="8" VerticalOptions="Center">
                    <Border WidthRequest="32"
                            HeightRequest="32"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 9"
                            BackgroundColor="#1B2C3A"
                            VerticalOptions="Center">
                        <Image Source="icon_hardhat.svg"
                               WidthRequest="20"
                               HeightRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Grid.Column="1"
                           Text="ScaffTrack"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1B2734"
                           VerticalOptions="Center" />
                </Grid>

                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        HeightRequest="124"
                        HorizontalOptions="Fill">
                    <Image Source="construction_site.jpg"
                           Aspect="AspectFill"
                           SemanticProperties.Description="Ouvriers sur un chantier de construction" />
                </Border>

                <VerticalStackLayout Spacing="2" Margin="0,1,0,2">
                    <Label Text="Prêt pour la journée ?"
                           FontSize="21"
                           FontAttributes="Bold"
                           TextColor="#1B2734" />
                    <Label Text="Connectez-vous à votre espace d’exploitation."
                           FontSize="12"
                           TextColor="#586B84" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Adresse e-mail *"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#1B2734" />
                    <Border Stroke="#D8E0E9"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            Padding="11,0">
                        <Entry Text="{Binding Email}"
                               Placeholder="nom@entreprise.com"
                               Keyboard="Email"
                               ReturnType="Next"
                               TextColor="#1B2734"
                               PlaceholderColor="#8A98A9"
                               HeightRequest="42" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Mot de passe *"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#1B2734" />
                    <Border Stroke="#D8E0E9"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            Padding="11,0">
                        <Entry Text="{Binding MotDePasse}"
                               Placeholder="Mot de passe"
                               IsPassword="True"
                               ReturnType="Go"
                               TextColor="#1B2734"
                               PlaceholderColor="#8A98A9"
                               HeightRequest="42" />
                    </Border>
                </VerticalStackLayout>

                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="#FDECEE"
                        Padding="11,9"
                        IsVisible="{Binding HasErrorMessage}">
                    <Grid ColumnDefinitions="18,*" ColumnSpacing="6">
                        <Label Text="!"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#C62828"
                               VerticalOptions="Start" />
                        <Label Grid.Column="1"
                               Text="{Binding MessageErreur}"
                               FontSize="11"
                               TextColor="#B4232C"
                               LineBreakMode="WordWrap" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,1">
                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                        <CheckBox IsChecked="True"
                                  Color="#1B2C3A"
                                  WidthRequest="22"
                                  HeightRequest="22"
                                  VerticalOptions="Center" />
                        <Label Text="Rester connecté"
                               FontSize="10"
                               TextColor="#1B2734"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Grid.Column="1"
                           Text="Mot de passe oublié ?"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="#D9470F"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding MotDePasseOublieCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Button Text="→   Se connecter"
                        Command="{Binding LoginCommand}"
                        BackgroundColor="#DE4A0A"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="13"
                        CornerRadius="9"
                        HeightRequest="44"
                        Padding="12,0" />

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                    <Label Text="Pas encore de compte ?"
                           FontSize="11"
                           TextColor="#586B84" />
                    <Label Text="Créer un compte"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#D9470F">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="#DE4A0A"
                                   HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
