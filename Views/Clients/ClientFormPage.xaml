<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ScaffTrack1.ViewModels.Clients"
             x:Class="ScaffTrack1.Views.Clients.ClientFormPage"
             x:DataType="vm:ClientsViewModel"
             Title="Ajouter un client"
             BackgroundColor="#F1F3F5">
    <ScrollView>
        <VerticalStackLayout Padding="18,16" Spacing="14">
            <Label Text="Coordonnées de facturation et de suivi" FontSize="12" TextColor="#586B84" />
            <Label Text="* Champs obligatoires" FontSize="11" TextColor="#586B84" />

            <VerticalStackLayout Spacing="5">
                <Label Text="Nom de l’entreprise *" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" />
                <Border Stroke="#D8E0E9" StrokeShape="RoundRectangle 9" BackgroundColor="White" Padding="10,0">
                    <Entry Text="{Binding NomEntreprise}" Placeholder="Ex. Mboa Construction" TextColor="#1B2734" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Nom du contact *" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" />
                <Border Stroke="#D8E0E9" StrokeShape="RoundRectangle 9" BackgroundColor="White" Padding="10,0">
                    <Entry Text="{Binding ContactNom}" Placeholder="Nom du responsable" TextColor="#1B2734" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Téléphone *" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" />
                <Border Stroke="#D8E0E9" StrokeShape="RoundRectangle 9" BackgroundColor="White" Padding="10,0">
                    <Entry Text="{Binding Telephone}" Keyboard="Telephone" Placeholder="+237 6..." TextColor="#1B2734" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Adresse e-mail *" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" />
                <Border Stroke="#D8E0E9" StrokeShape="RoundRectangle 9" BackgroundColor="White" Padding="10,0">
                    <Entry Text="{Binding Email}" Keyboard="Email" Placeholder="contact@entreprise.cm" TextColor="#1B2734" />
                </Border>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Ville *" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" />
                    <Border Stroke="#D8E0E9" StrokeShape="RoundRectangle 9" BackgroundColor="White" Padding="10,0">
                        <Entry Text="{Binding Ville}" TextColor="#1B2734" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="Quartier" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" />
                    <Border Stroke="#D8E0E9" StrokeShape="RoundRectangle 9" BackgroundColor="White" Padding="10,0">
                        <Entry Text="{Binding Adresse}" Placeholder="Akwa" TextColor="#1B2734" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Border IsVisible="{Binding HasError}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#FDECEE"
                    Padding="10">
                <Label Text="{Binding MessageErreur}" FontSize="11" TextColor="#B4232C" />
            </Border>

            <Button Text="Enregistrer le client"
                    Command="{Binding SaveClientCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="#DE4A0A"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="9"
                    HeightRequest="48" />
            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="#DE4A0A" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
