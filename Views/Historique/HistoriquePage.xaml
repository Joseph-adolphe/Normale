<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ScaffTrack1.ViewModels.Historique"
             xmlns:models="clr-namespace:ScaffTrack.Shared.Models;assembly=ScaffTrack.Shared"
             x:Class="ScaffTrack1.Views.Historique.HistoriquePage"
             x:DataType="vm:HistoriqueViewModel"
             Title="Historique"
             BackgroundColor="#F1F3F5">
    <Grid RowDefinitions="Auto,Auto,*">
        <VerticalStackLayout Padding="20,14,20,10" Spacing="2">
            <Label Text="Historique" FontSize="20" FontAttributes="Bold" TextColor="#1B2734" />
            <Label Text="Mouvements et restitutions du parc" FontSize="12" TextColor="#586B84" />
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Border Margin="16,0" Padding="10,0" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 9">
                <SearchBar Placeholder="Bon, matériel, chantier..." Text="{Binding Recherche}" BackgroundColor="Transparent" TextColor="#1B2734" PlaceholderColor="#8492A4" />
            </Border>
            <HorizontalStackLayout Padding="16,0" Spacing="8">
                <Button Text="Tout" Command="{Binding SelectFilterCommand}" CommandParameter="Tout" BackgroundColor="#1B2C3A" TextColor="White" FontSize="10" CornerRadius="7" Padding="12,5" />
                <Button Text="Sorties" Command="{Binding SelectFilterCommand}" CommandParameter="SortieChantier" BackgroundColor="White" TextColor="#586B84" BorderColor="#D8E0E9" BorderWidth="1" FontSize="10" CornerRadius="7" Padding="12,5" />
                <Button Text="Retours" Command="{Binding SelectFilterCommand}" CommandParameter="RetourStock" BackgroundColor="White" TextColor="#586B84" BorderColor="#D8E0E9" BorderWidth="1" FontSize="10" CornerRadius="7" Padding="12,5" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadHistoriqueCommand}">
            <CollectionView ItemsSource="{Binding MouvementsFiltres}" Margin="16,10,16,12" EmptyView="Aucun mouvement trouvé.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MouvementStock">
                        <Border Margin="0,0,0,9" Padding="12" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 11">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoriqueViewModel}}, Path=OpenMouvementCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="38,*,Auto" ColumnSpacing="9">
                                <Border WidthRequest="34" HeightRequest="34" BackgroundColor="#F1F3F5" StrokeThickness="0" StrokeShape="RoundRectangle 9">
                                    <Image Source="icon_history.svg" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding NumeroBon}" FontSize="12" FontAttributes="Bold" TextColor="#1B2734" />
                                    <Label Text="{Binding Chantier.Nom, TargetNullValue='Chantier'}" FontSize="11" TextColor="#586B84" />
                                    <Label Text="{Binding DateMouvement, StringFormat='{0:dd/MM/yyyy HH:mm}'}" FontSize="10" TextColor="#8492A4" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center">
                                    <Label Text="{Binding Type}" FontSize="10" FontAttributes="Bold" TextColor="#C2410C" HorizontalTextAlignment="End" />
                                    <Label Text="{Binding TotalArticles, StringFormat='{0} unités'}" FontSize="10" TextColor="#586B84" HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
