<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ScaffTrack1.ViewModels.Materiel"
             xmlns:models="clr-namespace:ScaffTrack.Shared.Models;assembly=ScaffTrack.Shared"
             x:Class="ScaffTrack1.Views.Materiel.MaterielListPage"
             x:DataType="vm:MaterielListViewModel"
             Title="Parc Matériel"
             BackgroundColor="#F1F3F5">

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Padding="20,12,16,8" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="Parc matériel" FontSize="20" FontAttributes="Bold" TextColor="#1B2734" />
                <Label Text="{Binding Materiels.Count, StringFormat='{0} références • Dépôt de Bassa'}" FontSize="12" TextColor="#586B84" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Ajuster"
                    Command="{Binding AdjustStockCommand}"
                    BackgroundColor="White"
                    TextColor="#DE4A0A"
                    FontSize="10"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="42"
                    Padding="10,0" />
            <Button Grid.Column="2"
                    Text="+"
                    Command="{Binding NewMaterielCommand}"
                    BackgroundColor="White"
                    TextColor="#DE4A0A"
                    FontSize="22"
                    CornerRadius="10"
                    WidthRequest="42"
                    HeightRequest="42"
                    Padding="0" />
        </Grid>

        <!-- Recherche de matériel -->
        <Border Grid.Row="1"
                Margin="16,4,16,10"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="White"
                Padding="10,0"
                Stroke="#D8E0E9">
            <SearchBar Placeholder="Rechercher par référence, nom, pièce..."
                       Text="{Binding SearchText}"
                       SearchCommand="{Binding SearchCommand}"
                       BackgroundColor="Transparent"
                       TextColor="#1B2734"
                       PlaceholderColor="#8492A4" />
        </Border>

        <!-- Liste du matériel -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadMaterielCommand}">
            <CollectionView ItemsSource="{Binding Materiels}"
                            Margin="16,0,16,10"
                            EmptyView="Aucun matériel trouvé.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Materiel">
                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="White"
                                Padding="16"
                                Margin="0,0,0,12"
                                Stroke="#D8E0E9"
                                StrokeThickness="1">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MaterielListViewModel}}, Path=OpenMaterielCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="{Binding Nom}" 
                                           FontAttributes="Bold" 
                                           FontSize="15" 
                                           TextColor="#0F172A" />

                                    <Border Grid.Column="1"
                                            StrokeShape="RoundRectangle 6"
                                            BackgroundColor="#F1F3F5"
                                            Padding="8,3"
                                            StrokeThickness="0">
                                        <Label Text="{Binding Reference}" 
                                               TextColor="#475569" 
                                               FontSize="11" 
                                               FontAttributes="Bold" />
                                    </Border>
                                </Grid>

                                <Label Text="{Binding Dimensions, StringFormat='Dimensions : {0}'}" 
                                       TextColor="#64748B" 
                                       FontSize="12" />

                                <!-- Badges de stock -->
                                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8" Margin="0,4">
                                    <Border BackgroundColor="#F8FAFC" Stroke="#D8E0E9" StrokeShape="RoundRectangle 6" Padding="6,4">
                                        <VerticalStackLayout HorizontalOptions="Center">
                                            <Label Text="Total" FontSize="10" TextColor="#64748B" HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding QuantiteTotale}" FontAttributes="Bold" FontSize="13" TextColor="#1E293B" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <Border Grid.Column="1" BackgroundColor="#FFF0E8" Stroke="#FBD5C2" StrokeShape="RoundRectangle 6" Padding="6,4">
                                        <VerticalStackLayout HorizontalOptions="Center">
                                            <Label Text="Chantier" FontSize="10" TextColor="#C2410C" HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding QuantiteEnChantier}" FontAttributes="Bold" FontSize="13" TextColor="#EA580C" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <Border Grid.Column="2" BackgroundColor="#E7F7EF" Stroke="#C6EBDD" StrokeShape="RoundRectangle 6" Padding="6,4">
                                        <VerticalStackLayout HorizontalOptions="Center">
                                            <Label Text="Disponible" FontSize="10" TextColor="#047857" HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding QuantiteDisponible}" FontAttributes="Bold" FontSize="13" TextColor="#10B981" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" Margin="0,2" />

                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="Tarif location / jour :" 
                                           TextColor="#64748B" 
                                           FontSize="12" 
                                           VerticalOptions="Center" />

                                    <Label Grid.Column="1" 
                                           Text="{Binding PrixLocationJourFCFA, StringFormat='{0:N0} FCFA'}" 
                                           TextColor="#EA580C" 
                                           FontAttributes="Bold" 
                                           FontSize="13" 
                                           VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
