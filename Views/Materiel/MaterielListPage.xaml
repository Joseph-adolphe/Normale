<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ScaffTrack1.ViewModels.Materiel"
             xmlns:models="clr-namespace:ScaffTrack.Shared.Models;assembly=ScaffTrack.Shared"
             x:Class="ScaffTrack1.Views.Materiel.MaterielListPage"
             x:DataType="vm:MaterielListViewModel"
             Title="Parc Matériel"
             BackgroundColor="#F4F6F9">

    <Grid RowDefinitions="Auto, *">
        <!-- Recherche de matériel -->
        <Border Margin="16,12"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="White"
                Padding="12,4"
                Stroke="#CBD5E1">
            <SearchBar Placeholder="Rechercher par référence, nom, pièce..."
                       Text="{Binding SearchText}"
                       SearchCommand="{Binding SearchCommand}"
                       BackgroundColor="Transparent" />
        </Border>

        <!-- Liste du matériel -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadMaterielCommand}">
            <CollectionView ItemsSource="{Binding Materiels}"
                            Margin="16,0,16,10">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Materiel">
                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="White"
                                Padding="16"
                                Margin="0,0,0,12"
                                Stroke="#E2E8F0"
                                StrokeThickness="1">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="{Binding Nom}" 
                                           FontAttributes="Bold" 
                                           FontSize="15" 
                                           TextColor="#0F172A" />

                                    <Border Grid.Column="1"
                                            StrokeShape="RoundRectangle 6"
                                            BackgroundColor="#F1F5F9"
                                            Padding="8,3"
                                            StrokeThickness="0">
                                        <Label Text="{Binding Reference}" 
                                               TextColor="#475569" 
                                               FontSize="11" 
                                               FontAttributes="Bold" />
                                    </Border>
                                </Grid>

                                <Label Text="{Binding Dimensions, StringFormat='Dimensions : {0}'}" 
                                       TextColor="#64748B" 
                                       FontSize="12" />

                                <!-- Badges de stock -->
                                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8" Margin="0,4">
                                    <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 6" Padding="6,4">
                                        <VerticalStackLayout HorizontalOptions="Center">
                                            <Label Text="Total" FontSize="10" TextColor="#64748B" HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding QuantiteTotale}" FontAttributes="Bold" FontSize="13" TextColor="#1E293B" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <Border Grid.Column="1" BackgroundColor="#FFF7ED" Stroke="#FFEDD5" StrokeShape="RoundRectangle 6" Padding="6,4">
                                        <VerticalStackLayout HorizontalOptions="Center">
                                            <Label Text="Chantier" FontSize="10" TextColor="#C2410C" HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding QuantiteEnChantier}" FontAttributes="Bold" FontSize="13" TextColor="#EA580C" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <Border Grid.Column="2" BackgroundColor="#ECFDF5" Stroke="#D1FAE5" StrokeShape="RoundRectangle 6" Padding="6,4">
                                        <VerticalStackLayout HorizontalOptions="Center">
                                            <Label Text="Disponible" FontSize="10" TextColor="#047857" HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding QuantiteDisponible}" FontAttributes="Bold" FontSize="13" TextColor="#10B981" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" Margin="0,2" />

                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="Tarif location / jour :" 
                                           TextColor="#64748B" 
                                           FontSize="12" 
                                           VerticalOptions="Center" />

                                    <Label Grid.Column="1" 
                                           Text="{Binding PrixLocationJourFCFA, StringFormat='{0:N0} FCFA'}" 
                                           TextColor="#EA580C" 
                                           FontAttributes="Bold" 
                                           FontSize="13" 
                                           VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
