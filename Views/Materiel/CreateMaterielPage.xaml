<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ScaffTrack1.ViewModels.Materiel"
             xmlns:models="clr-namespace:ScaffTrack.Shared.Models;assembly=ScaffTrack.Shared"
             x:Class="ScaffTrack1.Views.Materiel.CreateMaterielPage"
             x:DataType="vm:CreateMaterielViewModel"
             Title="Ajouter du matériel"
             BackgroundColor="#F1F3F5">
    <ScrollView>
        <VerticalStackLayout Padding="18,14" Spacing="12">
            <Label Text="* Champs obligatoires" FontSize="11" TextColor="#586B84" />
            <Border Padding="14" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="11">
                    <Label Text="Informations du matériel" FontSize="15" FontAttributes="Bold" TextColor="#1B2734" />
                    <Border Padding="10,0" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 9">
                        <Entry Text="{Binding Nom}" Placeholder="Nom du matériel *" TextColor="#1B2734" />
                    </Border>
                    <Border Padding="10,0" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 9">
                        <Entry Text="{Binding Reference}" Placeholder="Référence *" TextColor="#1B2734" />
                    </Border>
                    <Border Padding="8,0" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 9">
                        <Picker ItemsSource="{Binding Categories}" ItemDisplayBinding="{Binding Nom}" SelectedItem="{Binding SelectedCategorie}" Title="Catégorie *" TextColor="#1B2734" />
                    </Border>
                    <Border Padding="10,0" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 9">
                        <Entry Text="{Binding Dimensions}" Placeholder="Dimensions (ex. 2 m × 1 m)" TextColor="#1B2734" />
                    </Border>
                    <Border Padding="10,0" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 9">
                        <Entry Text="{Binding EmplacementDepot}" Placeholder="Emplacement au dépôt" TextColor="#1B2734" />
                    </Border>
                    <Label Text="Photo" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" />
                    <Border Padding="12" BackgroundColor="#F7F9FB" Stroke="#D8E0E9" StrokeShape="RoundRectangle 9">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Image Source="scaffolding_frame.jpg" HeightRequest="90" Aspect="AspectFit" />
                            <Label Text="Photo de référence" FontSize="10" TextColor="#586B84" />
                        </VerticalStackLayout>
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Stock total *" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" />
                            <Border Padding="10,0" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 9">
                                <Entry Text="{Binding QuantiteTotale}" Keyboard="Numeric" TextColor="#1B2734" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Tarif journalier" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" />
                            <Border Padding="10,0" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 9">
                                <Entry Text="{Binding PrixLocationJourFCFA}" Keyboard="Numeric" TextColor="#1B2734" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                    <Border Padding="10,0" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 9">
                        <Entry Text="{Binding PrixRemplacementFCFA}" Keyboard="Numeric" Placeholder="Valeur de remplacement (FCFA)" TextColor="#1B2734" />
                    </Border>
                    <Border Padding="10,4" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 9">
                        <Editor Text="{Binding Description}" HeightRequest="62" Placeholder="Description et consignes de contrôle" TextColor="#1B2734" />
                    </Border>
                </VerticalStackLayout>
            </Border>
            <Border IsVisible="{Binding HasError}" StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="#FDECEE" Padding="10">
                <Label Text="{Binding MessageErreur}" FontSize="11" TextColor="#B4232C" />
            </Border>
            <Button Text="Enregistrer le matériel" Command="{Binding SaveMaterielCommand}" IsEnabled="{Binding IsNotBusy}" BackgroundColor="#DE4A0A" TextColor="White" FontAttributes="Bold" CornerRadius="9" HeightRequest="48" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
