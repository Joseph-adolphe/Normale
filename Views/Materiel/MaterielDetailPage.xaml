<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ScaffTrack.Shared.Models;assembly=ScaffTrack.Shared"
             x:Class="ScaffTrack1.Views.Materiel.MaterielDetailPage"
             x:DataType="models:Materiel"
             Title="Fiche matériel"
             BackgroundColor="#F1F3F5">
    <ScrollView>
        <VerticalStackLayout Padding="18,14" Spacing="10">
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="150" BackgroundColor="White">
                <Image Source="scaffolding_frame.jpg" Aspect="AspectFill" SemanticProperties.Description="Cadres d’échafaudage stockés au dépôt" />
            </Border>
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Nom}" FontSize="19" FontAttributes="Bold" TextColor="#1B2734" />
                    <Label Text="{Binding Reference}" FontSize="11" TextColor="#586B84" />
                </VerticalStackLayout>
                <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 7" BackgroundColor="#E7F7EF" Padding="8,4" VerticalOptions="Center">
                    <Label Text="Disponible" FontSize="10" FontAttributes="Bold" TextColor="#087A50" />
                </Border>
            </Grid>
            <Border Padding="12" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Stock total" FontSize="11" TextColor="#586B84" /><Label Grid.Column="1" Text="{Binding QuantiteTotale, StringFormat='{0} unités'}" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" /></Grid>
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Disponible" FontSize="11" TextColor="#586B84" /><Label Grid.Column="1" Text="{Binding QuantiteDisponible}" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" /></Grid>
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Sur chantier" FontSize="11" TextColor="#586B84" /><Label Grid.Column="1" Text="{Binding QuantiteEnChantier}" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" /></Grid>
                    <Grid ColumnDefinitions="*,Auto"><Label Text="En maintenance" FontSize="11" TextColor="#586B84" /><Label Grid.Column="1" Text="{Binding QuantiteEnMaintenance}" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" /></Grid>
                </VerticalStackLayout>
            </Border>
            <Border Padding="12" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Tarif journalier" FontSize="11" TextColor="#586B84" /><Label Grid.Column="1" Text="{Binding PrixLocationJourFCFA, StringFormat='{0:N0} FCFA / unité'}" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" /></Grid>
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Dimensions" FontSize="11" TextColor="#586B84" /><Label Grid.Column="1" Text="{Binding Dimensions}" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" /></Grid>
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Dépôt" FontSize="11" TextColor="#586B84" /><Label Grid.Column="1" Text="{Binding EmplacementDepot}" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" /></Grid>
                    <Label Text="{Binding Description}" FontSize="11" TextColor="#586B84" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
