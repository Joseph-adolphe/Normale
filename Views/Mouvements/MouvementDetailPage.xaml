<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ScaffTrack.Shared.Models;assembly=ScaffTrack.Shared"
             x:Class="ScaffTrack1.Views.Mouvements.MouvementDetailPage"
             x:DataType="models:MouvementStock"
             Title="Bon de mouvement"
             BackgroundColor="#F1F3F5">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="16,14" Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Bon de sortie" FontSize="20" FontAttributes="Bold" TextColor="#1B2734" />
                        <Label Text="{Binding NumeroBon}" FontSize="11" TextColor="#586B84" />
                    </VerticalStackLayout>
                    <Image Grid.Column="1" Source="icon_clipboard.svg" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                </Grid>

                <Border Padding="12" BackgroundColor="#E7F7EF" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                    <Grid ColumnDefinitions="20,*" ColumnSpacing="6">
                        <Label Text="✓" FontSize="14" FontAttributes="Bold" TextColor="#087A50" />
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Mouvement enregistré" FontSize="12" FontAttributes="Bold" TextColor="#087A50" />
                            <Label Text="{Binding TotalArticles, StringFormat='{0} unités enregistrées et stock mis à jour.'}" FontSize="11" TextColor="#087A50" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Padding="13" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="ScaffTrack" FontSize="17" FontAttributes="Bold" TextColor="#1B2734" />
                            <Label Grid.Column="1" Text="{Binding Statut}" FontSize="10" FontAttributes="Bold" TextColor="#087A50" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="Dépôt de Bassa • Douala" FontSize="11" TextColor="#586B84" />
                        <BoxView HeightRequest="1" BackgroundColor="#D8E0E9" />
                        <Label Text="{Binding NumeroBon, StringFormat='BON DE MOUVEMENT • {0}'}" FontSize="14" FontAttributes="Bold" TextColor="#1B2734" />
                        <Grid ColumnDefinitions="*,Auto"><Label Text="Date" FontSize="11" TextColor="#586B84" /><Label Grid.Column="1" Text="{Binding DateMouvement, StringFormat='{0:dd/MM/yyyy}'}" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><Label Text="Chantier" FontSize="11" TextColor="#586B84" /><Label Grid.Column="1" Text="{Binding Chantier.Nom, TargetNullValue='—'}" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><Label Text="Client" FontSize="11" TextColor="#586B84" /><Label Grid.Column="1" Text="{Binding Chantier.Client.NomEntreprise, TargetNullValue='—'}" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" /></Grid>
                        <Grid ColumnDefinitions="*,Auto"><Label Text="Réceptionnaire" FontSize="11" TextColor="#586B84" /><Label Grid.Column="1" Text="{Binding NomRecepteur, TargetNullValue='—'}" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" /></Grid>
                        <Grid IsVisible="{Binding EstLocation}" ColumnDefinitions="*,Auto"><Label Text="Retour prévu" FontSize="11" TextColor="#586B84" /><Label Grid.Column="1" Text="{Binding DateRetourPrevue, StringFormat='{0:dd/MM/yyyy}', TargetNullValue='Non défini'}" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" /></Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#D8E0E9" />
                        <Label Text="MATÉRIEL / QUANTITÉ / TARIF JOURNALIER" FontSize="9" FontAttributes="Bold" TextColor="#65758B" />
                        <CollectionView ItemsSource="{Binding Lignes}" HeightRequest="210">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:LigneMouvement">
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,5">
                                        <Label Text="{Binding Materiel.Nom, TargetNullValue='Matériel'}" FontSize="11" TextColor="#586B84" />
                                        <Label Grid.Column="1" Text="{Binding Quantite, StringFormat='{0} unités'}" FontSize="11" FontAttributes="Bold" TextColor="#1B2734" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="{Binding Observations}" FontSize="10" TextColor="#586B84" />
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding EstLocation}" Padding="13" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="9">
                        <Label Text="Prolonger la location" FontSize="14" FontAttributes="Bold" TextColor="#1B2734" />
                        <Label Text="Choisissez la nouvelle date de retour prévue." FontSize="11" TextColor="#586B84" />
                        <DatePicker x:Name="ReturnDatePicker" Format="dd/MM/yyyy" TextColor="#1B2734" />
                        <Button Text="Enregistrer la prolongation" Clicked="OnExtendClicked" BackgroundColor="White" TextColor="#DE4A0A" BorderColor="#F0A27C" BorderWidth="1" FontAttributes="Bold" CornerRadius="9" HeightRequest="42" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="1"
                Text="Enregistrer une restitution"
                Clicked="OnReturnClicked"
                IsVisible="{Binding EstLocation}"
                BackgroundColor="#DE4A0A"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="9"
                Margin="16,8,16,12"
                HeightRequest="46" />
    </Grid>
</ContentPage>
