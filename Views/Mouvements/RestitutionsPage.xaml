<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ScaffTrack1.ViewModels.Mouvements"
             xmlns:models="clr-namespace:ScaffTrack.Shared.Models;assembly=ScaffTrack.Shared"
             x:Class="ScaffTrack1.Views.Mouvements.RestitutionsPage"
             x:DataType="vm:RestitutionsViewModel"
             Title="Restitutions"
             BackgroundColor="#F1F3F5">
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="20,12,16,8" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="Restitutions" FontSize="20" FontAttributes="Bold" TextColor="#1B2734" />
                <Label Text="{Binding Restitutions.Count, StringFormat='{0} mouvements enregistrés'}" FontSize="12" TextColor="#586B84" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="+" Command="{Binding NewReturnCommand}" BackgroundColor="White" TextColor="#DE4A0A" FontSize="22" CornerRadius="10" WidthRequest="42" HeightRequest="42" Padding="0" />
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadRestitutionsCommand}">
            <CollectionView ItemsSource="{Binding Restitutions}" Margin="16,2,16,12" EmptyView="Aucune restitution enregistrée.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MouvementStock">
                        <Border Margin="0,0,0,9" Padding="12" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RestitutionsViewModel}}, Path=OpenReturnCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                                <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="#E7F7EF">
                                    <Image Source="icon_clipboard.svg" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding Chantier.Nom, TargetNullValue='Restitution de stock'}" FontSize="13" FontAttributes="Bold" TextColor="#1B2734" />
                                    <Label Text="{Binding NumeroBon}" FontSize="10" TextColor="#586B84" />
                                    <Label Text="{Binding DateMouvement, StringFormat='{0:dd/MM/yyyy}'}" FontSize="10" TextColor="#586B84" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center">
                                    <Label Text="{Binding TotalArticles, StringFormat='{0} unités'}" FontSize="10" FontAttributes="Bold" TextColor="#087A50" HorizontalTextAlignment="End" />
                                    <Label Text="›" FontSize="20" TextColor="#65758B" HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
