<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ScaffTrack1.ViewModels.Mouvements"
             x:Class="ScaffTrack1.Views.Mouvements.SortieStockPage"
             x:DataType="vm:SortieStockViewModel"
             Title="Nouvelle location"
             BackgroundColor="#F1F3F5">

    <ScrollView>
        <VerticalStackLayout Padding="16,12" Spacing="12">

            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding TitreAction}" FontSize="20" FontAttributes="Bold" TextColor="#1B2734" />
                <Label Text="{Binding NomEtape, StringFormat='Étape 1 sur 3 • {0} et durée'}" FontSize="11" TextColor="#586B84" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*,*">
                <VerticalStackLayout Spacing="5">
                    <BoxView HeightRequest="3" BackgroundColor="#DE4A0A" CornerRadius="2" />
                    <Label Text="Chantier" FontSize="9" FontAttributes="Bold" TextColor="#1B2734" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="5" Margin="6,0">
                    <BoxView HeightRequest="3" BackgroundColor="#D8E0E9" CornerRadius="2" />
                    <Label Text="Matériel" FontSize="9" TextColor="#586B84" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="5" Margin="6,0,0,0">
                    <BoxView HeightRequest="3" BackgroundColor="#D8E0E9" CornerRadius="2" />
                    <Label Text="Bon de sortie" FontSize="9" TextColor="#586B84" />
                </VerticalStackLayout>
            </Grid>

            <!-- Sélection du Chantier Destinataire -->
            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="White"
                    Padding="12"
                    Stroke="#D8E0E9"
                    StrokeThickness="1">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Chantier *" FontAttributes="Bold" FontSize="12" TextColor="#1B2734" />
                    <Border StrokeShape="RoundRectangle 8" Stroke="#D8E0E9" BackgroundColor="White" Padding="10,0">
                        <Picker ItemsSource="{Binding Chantiers}"
                                ItemDisplayBinding="{Binding Nom}"
                                SelectedItem="{Binding SelectedChantier}"
                                Title="Sélectionner un chantier"
                                TextColor="#1B2734" />
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding DateMouvementLabel}" FontSize="10" FontAttributes="Bold" TextColor="#1B2734" />
                            <Border Stroke="#D8E0E9" StrokeShape="RoundRectangle 8" BackgroundColor="White" Padding="8,0">
                                <DatePicker Date="{Binding DateSortie}" Format="dd/MM/yyyy" TextColor="#1B2734" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding ShowDateReturn}">
                            <Label Text="Retour prévu *" FontSize="10" FontAttributes="Bold" TextColor="#1B2734" />
                            <Border Stroke="#D8E0E9" StrokeShape="RoundRectangle 8" BackgroundColor="White" Padding="8,0">
                                <DatePicker Date="{Binding DateRetourPrevu}" Format="dd/MM/yyyy" TextColor="#1B2734" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Sélection du Matériel & Quantités -->
            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="White"
                    Padding="12"
                    Stroke="#D8E0E9"
                    StrokeThickness="1">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="{Binding TitreSelectionMateriel}" FontAttributes="Bold" FontSize="14" TextColor="#1B2734" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Stock dispo" FontSize="10" TextColor="#586B84" VerticalOptions="Center" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding MaterielItems}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MaterielLigneItem">
                                <Border StrokeShape="RoundRectangle 10"
                                        BackgroundColor="White"
                                        Stroke="#D8E0E9"
                                        Padding="12"
                                        Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto,Auto">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Materiel.Nom}" FontAttributes="Bold" FontSize="13" TextColor="#1B2734" />
                                            <Label Text="{Binding Materiel.Reference}" FontSize="10" TextColor="#586B84" />
                                            <Label Text="{Binding Maximum, StringFormat='{0} disponibles'}" FontSize="10" TextColor="#586B84" FontAttributes="Bold" />
                                        </VerticalStackLayout>

                                        <!-- Contrôle de quantité +/- -->
                                        <Border Grid.Column="1"
                                                Grid.RowSpan="2"
                                                StrokeShape="RoundRectangle 8"
                                                BackgroundColor="White"
                                                Stroke="#D8E0E9"
                                                Padding="4,2"
                                                VerticalOptions="Start">
                                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                <Button Text="-"
                                                        Command="{Binding DecrementCommand}"
                                                        BackgroundColor="#F1F3F5"
                                                        TextColor="#1B2734"
                                                        FontAttributes="Bold"
                                                        CornerRadius="6"
                                                        WidthRequest="32"
                                                        HeightRequest="32"
                                                        Padding="0" />

                                                <Label Text="{Binding Quantite}"
                                                       FontAttributes="Bold"
                                                       FontSize="16"
                                                       TextColor="#DE4A0A"
                                                       VerticalOptions="Center"
                                                       HorizontalTextAlignment="Center"
                                                       WidthRequest="30" />

                                                <Button Text="+"
                                                        Command="{Binding IncrementCommand}"
                                                        BackgroundColor="#DE4A0A"
                                                        TextColor="White"
                                                        FontAttributes="Bold"
                                                        CornerRadius="6"
                                                        WidthRequest="32"
                                                        HeightRequest="32"
                                                        Padding="0" />
                                            </HorizontalStackLayout>
                                        </Border>
                                        <Grid Grid.Row="1"
                                              ColumnDefinitions="*,*"
                                              ColumnSpacing="7"
                                              Margin="0,8,0,0"
                                              IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:SortieStockViewModel}}, Path=IsRetour}">
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="Endommagé" FontSize="9" TextColor="#586B84" />
                                                <Border Padding="5,0" Stroke="#D8E0E9" StrokeShape="RoundRectangle 7" BackgroundColor="White">
                                                    <Entry Text="{Binding QuantiteEndommagee}" Keyboard="Numeric" FontSize="11" TextColor="#1B2734" />
                                                </Border>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                <Label Text="Perdu" FontSize="9" TextColor="#586B84" />
                                                <Border Padding="5,0" Stroke="#D8E0E9" StrokeShape="RoundRectangle 7" BackgroundColor="White">
                                                    <Entry Text="{Binding QuantitePerdue}" Keyboard="Numeric" FontSize="11" TextColor="#1B2734" />
                                                </Border>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Réception & Signataire -->
            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="White"
                    Padding="12"
                    Stroke="#D8E0E9"
                    StrokeThickness="1">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Informations de suivi" FontAttributes="Bold" FontSize="13" TextColor="#1B2734" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nom du réceptionnaire" FontSize="12" FontAttributes="Bold" TextColor="#475569" />
                        <Border StrokeShape="RoundRectangle 8" Stroke="#CBD5E1" BackgroundColor="#F8FAFC" Padding="10,2">
                            <Entry Text="{Binding NomRecepteur}" Placeholder="Ex: Chef de chantier sur place" TextColor="#0F172A" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Téléphone réceptionnaire" FontSize="12" FontAttributes="Bold" TextColor="#475569" />
                        <Border StrokeShape="RoundRectangle 8" Stroke="#CBD5E1" BackgroundColor="#F8FAFC" Padding="10,2">
                            <Entry Text="{Binding TelephoneRecepteur}" Placeholder="+237 6..." Keyboard="Telephone" TextColor="#0F172A" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Observations / N° Camion" FontSize="12" FontAttributes="Bold" TextColor="#475569" />
                        <Border StrokeShape="RoundRectangle 8" Stroke="#CBD5E1" BackgroundColor="#F8FAFC" Padding="10,4">
                            <Editor Text="{Binding Observations}" HeightRequest="60" Placeholder="Véhicule, chauffeur, remarques..." TextColor="#0F172A" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Bouton Valider -->
            <Border IsVisible="{Binding HasError}" StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="#FDECEE" Padding="10">
                <Label Text="{Binding MessageErreur}" FontSize="11" TextColor="#B4232C" />
            </Border>

            <Button Text="{Binding TexteValidation}"
                    Command="{Binding ValiderBonSortieCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="#DE4A0A"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="13"
                    CornerRadius="9"
                    HeightRequest="46"
                    Margin="0,0,0,16" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
