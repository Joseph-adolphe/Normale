<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ScaffTrack1.ViewModels.Dashboard"
             xmlns:models="clr-namespace:ScaffTrack.Shared.Models;assembly=ScaffTrack.Shared"
             x:Class="ScaffTrack1.Views.Dashboard.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Accueil"
             BackgroundColor="#F1F3F5">
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="20,12,18,12" ColumnDefinitions="*,Auto" BackgroundColor="White">
            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="{Binding NomUtilisateur, StringFormat='Bonjour, {0}'}" FontSize="18" FontAttributes="Bold" TextColor="#1B2734" />
                <Label Text="Dépôt de Bassa • Douala" FontSize="11" TextColor="#586B84" />
            </VerticalStackLayout>
            <Border Grid.Column="1" WidthRequest="34" HeightRequest="34" StrokeThickness="0" StrokeShape="RoundRectangle 9" BackgroundColor="#F1F3F5">
                <Image Source="icon_bell.svg" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding VoirAlertesCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,12,16,18" Spacing="10">
                <Border Padding="14" BackgroundColor="#142B3A" StrokeThickness="0" StrokeShape="RoundRectangle 13">
                    <VerticalStackLayout Spacing="9">
                        <Label Text="ÉTAT DU PARC • EN DIRECT" FontSize="9" TextColor="#B9C8D2" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Stats.TotalUnites, StringFormat='{0:N0}'}" FontSize="28" FontAttributes="Bold" TextColor="White" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End" Spacing="1">
                                <Label Text="unités suivies" FontSize="9" TextColor="#CED8E0" HorizontalTextAlignment="End" />
                                <Label Text="4 catégories" FontSize="9" TextColor="#CED8E0" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                        <Grid HeightRequest="6" ColumnSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="63*" />
                                <ColumnDefinition Width="34*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <BoxView BackgroundColor="#13835C" CornerRadius="3" />
                            <BoxView Grid.Column="1" BackgroundColor="#3474A1" CornerRadius="3" />
                            <BoxView Grid.Column="2" BackgroundColor="#C38D18" CornerRadius="3" />
                        </Grid>
                        <Label Text="{Binding Stats.TauxOccupation, StringFormat='{0:N0} % disponibles • {1:N0} % sortis • contrôle sécurité'}"
                               FontSize="9"
                               TextColor="#CED8E0" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Border Padding="12" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding Stats.UnitesDisponibles, StringFormat='{0:N0}'}" FontSize="22" FontAttributes="Bold" TextColor="#087A50" />
                            <Label Text="✓ Disponibles" FontSize="10" TextColor="#586B84" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Padding="12" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding Stats.UnitesSurChantiers, StringFormat='{0:N0}'}" FontSize="22" FontAttributes="Bold" TextColor="#28618D" />
                            <Label Text="↗ Sur chantier" FontSize="10" TextColor="#586B84" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Padding="12" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding Stats.UnitesEnMaintenance, StringFormat='{0:N0}'}" FontSize="22" FontAttributes="Bold" TextColor="#9A6B0A" />
                            <Label Text="En maintenance" FontSize="10" TextColor="#586B84" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Padding="12" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding Stats.AlertesNonResolues, StringFormat='{0:N0}'}" FontSize="22" FontAttributes="Bold" TextColor="#B4232C" />
                            <Label Text="Locations en retard" FontSize="10" TextColor="#586B84" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border IsVisible="{Binding HasAlerts}" Padding="10" BackgroundColor="#FDECEE" StrokeThickness="0" StrokeShape="RoundRectangle 9">
                    <Grid ColumnDefinitions="20,*" ColumnSpacing="6">
                        <Image Source="icon_alert.svg" WidthRequest="16" HeightRequest="16" VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="{Binding Stats.AlertesNonResolues, StringFormat='{0} retours à relancer'}" FontSize="11" FontAttributes="Bold" TextColor="#B4232C" />
                            <Label Text="Consultez les retards et enregistrez les restitutions en attente." FontSize="10" TextColor="#B4232C" />
                        </VerticalStackLayout>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding VoirAlertesCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="+  Affecter"
                            Command="{Binding NouveauBonSortieCommand}"
                            BackgroundColor="#DE4A0A"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="9"
                            HeightRequest="42" />
                    <Button Grid.Column="1"
                            Text="↵  Restituer"
                            Command="{Binding RetourMaterielCommand}"
                            BackgroundColor="White"
                            TextColor="#1B2734"
                            BorderColor="#D8E0E9"
                            BorderWidth="1"
                            FontAttributes="Bold"
                            CornerRadius="9"
                            HeightRequest="42" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="À suivre aujourd’hui" FontSize="14" FontAttributes="Bold" TextColor="#1B2734" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Historique ›" FontSize="10" FontAttributes="Bold" TextColor="#DE4A0A" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VoirHistoriqueCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <CollectionView ItemsSource="{Binding ChantiersRecents}" HeightRequest="180">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Chantier">
                            <Border Margin="0,0,0,8" Padding="10" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 11">
                                <Grid ColumnDefinitions="34,*,Auto" ColumnSpacing="8">
                                    <Border WidthRequest="32" HeightRequest="32" StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="#F1F3F5">
                                        <Image Source="icon_clipboard.svg" WidthRequest="17" HeightRequest="17" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding Nom}" FontSize="12" FontAttributes="Bold" TextColor="#1B2734" />
                                        <Label Text="{Binding Code}" FontSize="10" TextColor="#586B84" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="›" FontSize="18" TextColor="#65758B" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
