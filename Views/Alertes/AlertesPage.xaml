<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ScaffTrack1.ViewModels.Alertes"
             xmlns:models="clr-namespace:ScaffTrack.Shared.Models;assembly=ScaffTrack.Shared"
             x:Class="ScaffTrack1.Views.Alertes.AlertesPage"
             x:DataType="vm:AlertesViewModel"
             Title="Notifications"
             BackgroundColor="#F1F3F5">
    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="20,14,20,10" Spacing="2">
            <Label Text="Notifications" FontSize="20" FontAttributes="Bold" TextColor="#1B2734" />
            <Label Text="{Binding Alertes.Count, StringFormat='{0} alertes à traiter'}" FontSize="12" TextColor="#586B84" />
        </VerticalStackLayout>
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadAlertesCommand}">
            <CollectionView ItemsSource="{Binding Alertes}" Margin="16,0,16,12" EmptyView="Aucune alerte en cours.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Alerte">
                        <Border Margin="0,0,0,10" Padding="12" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 12">
                            <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="8">
                                <Image Source="icon_alert.svg" WidthRequest="19" HeightRequest="19" VerticalOptions="Start" />
                                <VerticalStackLayout Grid.Column="1" Spacing="5">
                                    <Label Text="{Binding Titre}" FontSize="13" FontAttributes="Bold" TextColor="#1B2734" />
                                    <Label Text="{Binding Message}" FontSize="11" TextColor="#586B84" LineBreakMode="WordWrap" />
                                    <Label Text="{Binding DateCreation, StringFormat='{0:dd/MM/yyyy HH:mm}'}" FontSize="10" TextColor="#8492A4" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2"
                                        Text="Traiter"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AlertesViewModel}}, Path=ResolveCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#FFF0E8"
                                        TextColor="#C2410C"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        CornerRadius="7"
                                        Padding="8,4"
                                        VerticalOptions="Start" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
