<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScaffTrack1.Views.Plus.PlusPage"
             Title="Plus"
             BackgroundColor="#F1F3F5">
    <ScrollView>
        <VerticalStackLayout Padding="18,14" Spacing="12">
            <Label Text="Plus" FontSize="20" FontAttributes="Bold" TextColor="#1B2734" />
            <Label Text="Votre espace et vos outils" FontSize="12" TextColor="#586B84" />

            <Border Padding="12" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 12">
                <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                    <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="#E8F1F7">
                        <Image Source="icon_user.svg" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="Mon profil" FontSize="13" FontAttributes="Bold" TextColor="#1B2734" />
                        <Label Text="Compte et préférences" FontSize="10" TextColor="#586B84" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#65758B" VerticalOptions="Center" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped" />
                    </Grid.GestureRecognizers>
                </Grid>
            </Border>

            <Label Text="GESTION" FontSize="10" FontAttributes="Bold" TextColor="#65758B" Margin="2,6,0,0" />
            <Border Padding="12" BackgroundColor="White" Stroke="#D8E0E9" StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="36,*,Auto" Padding="0,8">
                        <Image Source="icon_bell.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Notifications et alertes" FontSize="12" TextColor="#1B2734" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#65758B" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnAlertsTapped" /></Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#EEF1F4" />
                    <Grid ColumnDefinitions="36,*,Auto" Padding="0,8">
                        <Image Source="icon_clipboard.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Clients" FontSize="12" TextColor="#1B2734" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#65758B" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnClientsTapped" /></Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#EEF1F4" />
                    <Grid ColumnDefinitions="36,*,Auto" Padding="0,8">
                        <Image Source="icon_dashboard.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Historique des mouvements" FontSize="12" TextColor="#1B2734" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#65758B" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnHistoryTapped" /></Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#EEF1F4" />
                    <Grid ColumnDefinitions="36,*,Auto" Padding="0,8">
                        <Image Source="icon_clipboard.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Restitutions" FontSize="12" TextColor="#1B2734" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#65758B" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnReturnsTapped" /></Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#EEF1F4" />
                    <Grid ColumnDefinitions="36,*,Auto" Padding="0,8">
                        <Image Source="icon_offline.svg" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="État de la connexion" FontSize="12" TextColor="#1B2734" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#65758B" />
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnConnectionTapped" /></Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Se déconnecter"
                    Clicked="OnSignOutClicked"
                    BackgroundColor="White"
                    TextColor="#B4232C"
                    BorderColor="#D8E0E9"
                    BorderWidth="1"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="46" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
