<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ScaffTrack1.ViewModels.Chantiers"
             xmlns:models="clr-namespace:ScaffTrack.Shared.Models;assembly=ScaffTrack.Shared"
             x:Class="ScaffTrack1.Views.Chantiers.ChantierListPage"
             x:DataType="vm:ChantierListViewModel"
             Title="Chantiers"
             BackgroundColor="#F4F6F9">

    <Grid RowDefinitions="Auto, *">
        <!-- Barre de recherche -->
        <Border Margin="16,12"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="White"
                Padding="12,4"
                Stroke="#CBD5E1">
            <SearchBar Placeholder="Rechercher un chantier, client, ville..."
                       Text="{Binding SearchText}"
                       SearchCommand="{Binding SearchCommand}"
                       BackgroundColor="Transparent" />
        </Border>

        <!-- Liste des chantiers avec rafraîchissement -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadChantiersCommand}">
            <CollectionView ItemsSource="{Binding Chantiers}"
                            Margin="16,0,16,10">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Chantier">
                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="White"
                                Padding="16"
                                Margin="0,0,0,12"
                                Stroke="#E2E8F0"
                                StrokeThickness="1">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="{Binding Nom}" 
                                           FontAttributes="Bold" 
                                           FontSize="16" 
                                           TextColor="#0F172A" />

                                    <Border Grid.Column="1"
                                            StrokeShape="RoundRectangle 6"
                                            BackgroundColor="#FEF3C7"
                                            Padding="8,3"
                                            StrokeThickness="0">
                                        <Label Text="En cours" 
                                               TextColor="#B45309" 
                                               FontSize="11" 
                                               FontAttributes="Bold" />
                                    </Border>
                                </Grid>

                                <Label Text="{Binding Code, StringFormat='Réf : {0}'}" 
                                       TextColor="#64748B" 
                                       FontSize="12" />

                                <Label Text="{Binding Adresse, StringFormat='📍 {0}'}" 
                                       TextColor="#475569" 
                                       FontSize="13" />

                                <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" Margin="0,4" />

                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="{Binding DateDebut, StringFormat='Début : {0:dd/MM/yyyy}'}" 
                                           TextColor="#64748B" 
                                           FontSize="12" 
                                           VerticalOptions="Center" />

                                    <Label Grid.Column="1" 
                                           Text="{Binding MontantLocationPrevueFCFA, StringFormat='{0:N0} FCFA'}" 
                                           TextColor="#EA580C" 
                                           FontAttributes="Bold" 
                                           FontSize="14" 
                                           VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
