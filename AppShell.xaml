<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ScaffTrack1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewsAuth="clr-namespace:ScaffTrack1.Views.Auth"
    xmlns:viewsDashboard="clr-namespace:ScaffTrack1.Views.Dashboard"
    xmlns:viewsChantiers="clr-namespace:ScaffTrack1.Views.Chantiers"
    xmlns:viewsMateriel="clr-namespace:ScaffTrack1.Views.Materiel"
    xmlns:viewsLocations="clr-namespace:ScaffTrack1.Views.Locations"
    xmlns:viewsClients="clr-namespace:ScaffTrack1.Views.Clients"
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarForegroundColor="#DE4A0A"
    Shell.TabBarUnselectedColor="#65758B"
    Title="ScaffTrack">

    <!-- 1. Page de démarrage : Authentification / Connexion -->
    <ShellContent
        Title="Connexion"
        ContentTemplate="{DataTemplate viewsAuth:LoginPage}"
        Route="LoginPage" />

    <!-- 2. Application Principale (Barre d'onglets) -->
    <TabBar Route="main">
        <Tab Title="Accueil" Route="home" Icon="icon_dashboard.svg">
            <ShellContent
                Title="Accueil"
                ContentTemplate="{DataTemplate viewsDashboard:DashboardPage}"
                Route="DashboardPage" />
        </Tab>

        <Tab Title="Parc" Route="parc" Icon="icon_material.svg">
            <ShellContent
                Title="Parc"
                ContentTemplate="{DataTemplate viewsMateriel:MaterielListPage}"
                Route="MaterielListPage" />
        </Tab>

        <Tab Title="Chantiers" Route="chantiers" Icon="icon_hardhat.svg">
            <ShellContent
                Title="Chantiers"
                ContentTemplate="{DataTemplate viewsChantiers:ChantierListPage}"
                Route="ChantierListPage" />
        </Tab>

        <Tab Title="Locations" Route="locations" Icon="icon_clipboard.svg">
            <ShellContent
                Title="Locations"
                ContentTemplate="{DataTemplate viewsLocations:LocationsPage}"
                Route="LocationsPage" />
        </Tab>

        <Tab Title="Plus" Route="plus" Icon="icon_menu.svg">
            <ShellContent
                Title="Plus"
                ContentTemplate="{DataTemplate viewsClients:ClientsPage}"
                Route="ClientsPage" />
        </Tab>
    </TabBar>

</Shell>
